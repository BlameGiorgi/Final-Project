<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Blog | Blogs</title>
    <link rel="stylesheet" href="./stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
    <link rel="stylesheet" href="./stylesheets/blogs.css">
    <link rel="stylesheet" href="./stylesheets/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Sen:wght@400..800&display=swap"
          rel="stylesheet">
    <link rel="shortcut icon" href="./images/blog-icon.svg" type="image/x-icon">
</head>
<body>
<%- include('partials/header', {email: email}); %>

<h1 class="blog-title container">
    THE BLOG
</h1>


<p class="blogs-paragraph container">
    Recent blog posts
</p>
<div class="new-container container">

    <div class="posts-container">

        <div class="review-blog">
            <img src="/images/ux.jpg" alt="image">
            <p class="author"></p>
            <p class="title">
                <%= recentBlogPosts[0].title %>
                <img class="arrow-icon" src="/images/icon.svg" alt="Arrow">
            </p>
            <p class="description">
                <%= recentBlogPosts[0].description %>

            </p>
            <div class="categories">
                <p class="ux-design category">Design</p>
                <p class="ux-research category">Research</p>
                <p class="ux-presentation category">Presentation</p>
            </div>
        </div>

        <div class="small-blog">
            <div class="migrating-blog">
                <img src="/images/migrating.jpg" alt="image">
                <div class="migrating-texts">
                    <p class="author"></p>
                    <p class="title">
                        <%= recentBlogPosts[1].title %>
                    </p>
                    <p class="description">
                        <%= recentBlogPosts[1].description %>

                    </p>
                    <div class="categories">
                        <p class="migrating-design category">Design</p>
                        <p class="migrating-research category">Research</p>
                    </div>
                </div>
            </div>

            <div class="api-blog">
                <img src="/images/api.jpg" alt="img">
                <div>
                    <p class="author"></p>
                    <p class="title">    <%= recentBlogPosts[2].title %>
                    </p>
                    <p class="description modify">
                        <%= recentBlogPosts[2].description %>
                    </p>
                    <div class="categories">
                        <p class="category api-design">Design</p>
                        <p class="category api-research">Research</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="wide-card-wrapper container">
    <div class="wide-card">
        <img src="/images/grid.jpg" alt="Grid">
        <div class="wide-card-texts">
            <p class="author"></p>
            <p class="title wide-title">
                <%= recentBlogPosts[3].title %>

                <img class="arrow-icon" src="/images/icon.svg" alt="Arrow">
            </p>
            <p class="description">
                <%= recentBlogPosts[3].description %>

            </p>
            <div class="categories">
                <p class="category ux-design">Design</p>
                <p class="category ux-research">Interface</p>
            </div>
        </div>
    </div>
</div>

<p class="blogs-paragraph all-posts-label container">All blog posts</p>

<div class="all-posts-wrapper container">
    <div class="all-posts-grid container">
        <% recentBlogPosts.forEach(function(blog) { %>
            <div class="post-card">
                <%= blog.author.email %>
                - <%= blog.date.getDate() %> <%= blog.date.toLocaleString('en-US', {month: 'short'}) %> <%= blog.date.getFullYear() %>
                <img src="/images/walsh.jpg" alt="walsh">
                <p class="author">
                <p class="author"></p>
                <p class="title"><%= blog.title %></p></p>
                <p class="title card-title">

                    <img class="arrow-icon" src="/images/icon.svg" alt="Arrow">
                </p>
                <p class="description">
                    <%= blog.description %>
                </p>
                <div class="categories">
                    <p class="category ux-design">Design</p>
                    <p class="category ux-research">Research</p>
                </div>
            </div>
        <% }); %>
    </div>

    <%- include('partials/footer'); %>

</div>
</body>
</html>