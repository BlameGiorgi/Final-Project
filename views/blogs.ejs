<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Blog | Blogs</title>
    <link rel="stylesheet" href="./stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
    <link rel="stylesheet" href="./stylesheets/blogs.css">
    <link rel="stylesheet" href="./stylesheets/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Sen:wght@400..800&display=swap"
          rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.svg" type="image/x-icon">
</head>
<body>
<%- include('partials/header', {email: email}); %>

<h1 class="blog-title container">
    THE BLOG
</h1>

<div class="container recent-blogs-wrapper">
    <h4 class="title">Recent blog posts</h4>
    <div class="row-1">
        <div class="col-1">
            <div class="media">
                <figure class="thumbnail-wrapper">
                    <img src="/images/ux.jpg" alt="Thumbnail 1">
                </figure>
                <div class="blog-meta">
                    <p><%= blogs[0].author.email %></p> <span> • </span>
                    <p><%= blogs[0].date.getDate() %> <%= blogs[0].date.toLocaleString('default', {month: 'short'}) %> <%= blogs[0].date.getFullYear() %></p>
                </div>
                <figure class="blog-title-wrapper">
                    <a href="/"><%= blogs[0].title %></a>
                    <img src="/images/icon.svg" alt="Arrow up icon">
                </figure>
                <div class="description-wrapper">
                    <p><%= blogs[0].description %></p>
                </div>
            </div>
        </div>
        <div class="col-2">

            <div class="blog-title-small-text-1">
                <figure class="thumbnail-wrapper-small">
                    <img src="/images/migrating.jpg" alt="Thumbnail 1">
                </figure>
                <div class="text-1">
                    <div class="blog-meta-2">
                        <p><%= blogs[1].author.email %></p> <span> • </span>
                        <p><%= blogs[1].date.getDate() %> <%= blogs[1].date.toLocaleString('default', {month: 'short'}) %> <%= blogs[0].date.getFullYear() %></p>
                    </div>
                    <figure class="blog-title-wrappper-small">
                        <a class="text-1-2-meta" href="/"><%= blogs[1].title %></a>
                    </figure>
                    <div class="description-wrapper-small">
                        <p><%= blogs[1].description %></p>
                    </div>
                </div>
            </div>


            <div class="blog-title-small-text-2">
                <figure class="thumbnail-wrapper-small">
                    <img src="/images/api.jpg" alt="Thumbnail 1">
                </figure>
                <div class="text-2">
                    <div class="blog-meta-2">
                        <p><%= blogs[2].author.email %></p> <span> • </span>
                        <p> <%= blogs[2].date.getDate() %> <%= blogs[2].date.toLocaleString('default', {month: 'short'}) %> <%= blogs[0].date.getFullYear() %></p>
                    </div>
                    <figure class="blog-title-wrapper-small">
                        <a class="text-1-2-meta" href="/"><%= blogs[2].title %></a>
                    </figure>
                    <div class="description-wrapper-small">
                        <p><%= blogs[2].description %></p>
                    </div>
                </div>
            </div>


        </div>

    </div>
    <div class="col-3">
        <div class="blog-title-bottom-text-3">
            <figure class="thumbnail-wrapper-bottom">
                <img src="/images/grid.jpg" alt="Thumbnail 1">
            </figure>
            <div class="text-3">
                <div class="blog-meta-2">
                    <p><%= blogs[3].author.email %></p> <span> • </span>
                    <p><%= blogs[3].date.getDate() %> <%= blogs[3].date.toLocaleString('default', {month: 'short'}) %> <%= blogs[0].date.getFullYear() %></p>
                </div>
                <figure class="blog-title-wrapper-bottom">
                    <a href="/"><%= blogs[3].title %></a>
                    <img src="/images/icon.svg" alt="Arrow up icon">
                </figure>
                <div class="description-wrapper-bottom">
                    <p><%= blogs[3].description %></p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="all-posts-grid container">
    <h4 class="title-2">All blog posts</h4>
    <div class=" all-posts-wrapper container">
        <% blogs.forEach(function(blog) { %>
            <div class="post-card">

                <figure class="all-blog-image-wrapper">
                    <img src="/images/mountains.jpg" alt="mountains">
                </figure>
                <div class="text-4">
                    <div class="blog-meta">
                        <p><%= blog.author.email %></p> <span> • </span>
                        <p><%= blog.date.getDate() %> <%= blog.date.toLocaleString('default', {month: 'short'}) %> <%= blog.date.getFullYear() %></p>
                    </div>
                    <div class="all-blog-arrow">
                        <p><%= blog.title %> </p>
                        <p><img class="arrow-icon" src="/images/icon.svg" alt="Arrow"></p>
                    </div>
                    <p class="description">
                        <%= blog.description %>
                    </p>
                </div>
            </div>
        <% }); %>
    </div>
</div>
<%- include('partials/footer'); %>
</body>
</html>